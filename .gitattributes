* text=auto
*.php text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.md text eol=lf
*.cjs text eol=lf
*.ps1 text eol=lf
bin/wsdd-php-admin text eol=lf
bin/validate-* text eol=lf

# Keep development evidence in Git, not in installable archives.
.gitattributes export-ignore
.gitignore export-ignore
.github export-ignore
test export-ignore
var export-ignore
docs/*.md export-ignore
docs/INSTALL.md -export-ignore
bin/validate-* export-ignore
bin/build-release.ps1 export-ignore
deploy/container export-ignore
**/.gitkeep export-ignore
