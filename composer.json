{
  "name": "wsdd/php-admin",
  "description": "Web admin installed inside PHP containers to manage PHP extensions and configuration with persistent profile reconciliation.",
  "type": "project",
  "license": "MIT",
  "homepage": "https://github.com/wnunezc/WSDD-PHP-Admin",
  "authors": [
    {"name": "wnunezc", "homepage": "https://github.com/wnunezc"}
  ],
  "support": {
    "issues": "https://github.com/wnunezc/WSDD-PHP-Admin/issues",
    "source": "https://github.com/wnunezc/WSDD-PHP-Admin"
  },
  "require": {
    "php": "^5.6 || ^7.0 || ^8.0"
  },
  "autoload": {
    "psr-4": {
      "Wsdd\\PhpAdmin\\": "src/"
    }
  },
  "bin": [
    "bin/wsdd-php-admin"
  ],
  "scripts": {
    "check": [
      "php -l public/index.php",
      "php -l bin/wsdd-php-admin"
    ]
  }
}
