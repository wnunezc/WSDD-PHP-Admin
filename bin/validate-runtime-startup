#!/usr/bin/env php
<?php

require dirname(__DIR__) . '/src/Support/bootstrap.php';

use Wsdd\PhpAdmin\Support\AppConfig;
use Wsdd\PhpAdmin\Support\CommandRunner;
use Wsdd\PhpAdmin\Support\InstanceLock;
use Wsdd\PhpAdmin\Runtime\RuntimeStarter;
use Wsdd\PhpAdmin\Operations\OperationRepository;
use Wsdd\PhpAdmin\Operations\OperationService;

function check($condition, $message) {
    if (!$condition) throw new RuntimeException($message);
    echo 'PASS ' . $message . PHP_EOL;
}
function privateCall($object, $method, array $args = []) {
    $reflection = new ReflectionMethod($object, $method);
    $reflection->setAccessible(true);
    return $reflection->invokeArgs($object, $args);
}
function privateSet($object, $property, $value) {
    $reflection = new ReflectionProperty($object, $property);
    $reflection->setAccessible(true);
    $reflection->setValue($object, $value);
}
function removeFixture($path) {
    if (is_dir($path) && !is_link($path)) {
        foreach (new DirectoryIterator($path) as $item) if (!$item->isDot()) removeFixture($item->getPathname());
        rmdir($path);
    } else { unlink($path); }
}
function freePort() {
    $socket = stream_socket_server('tcp://127.0.0.1:0', $errno, $message);
    if ($socket === false) throw new RuntimeException($message);
    $port = (int) substr(strrchr(stream_socket_get_name($socket, false), ':'), 1);
    fclose($socket);
    return $port;
}

check(function_exists('posix_geteuid') && posix_geteuid() === 0, 'Isolated runtime test has root privileges');
$root = dirname(__DIR__);
$realConfig = AppConfig::loadDefault();
$before = hash_file('sha256', $realConfig->profilePath());
$base = sys_get_temp_dir() . '/wsdd-startup-test-' . bin2hex(random_bytes(6));
mkdir($base, 0755);
foreach (['state', 'logs', 'ini'] as $name) mkdir($base . '/' . $name, 0775);
mkdir($base . '/state/runtime', 0755);
// Reuse the existing Apache probe credential only inside this disposable root-owned fixture.
copy($realConfig->persistentRoot() . '/runtime/probe.key', $base . '/state/runtime/probe.key');
chmod($base . '/state/runtime/probe.key', 0640);
chgrp($base . '/state/runtime/probe.key', 'www-data');
$environment = ['WSDD_PHP_ADMIN_PROFILE_DIR' => $base . '/state', 'WSDD_PHP_ADMIN_INI_DIR' => $base . '/ini', 'WSDD_PHP_ADMIN_LOG_DIR' => $base . '/logs', 'WSDD_PHP_ADMIN_AGENT_LOG' => $base . '/logs/agent.log', 'WSDD_PHP_ADMIN_AUDIT_LOG' => $base . '/logs/audit.log', 'WSDD_PHP_ADMIN_PORT' => (string) freePort()];
$previous = [];
foreach ($environment as $name => $value) { $previous[$name] = getenv($name); putenv($name . '=' . $value); }
$config = AppConfig::loadDefault();
$starter = new RuntimeStarter($config, $root);
$failureStarter = null;
$runner = new CommandRunner();
$cli = $root . '/bin/wsdd-php-admin';
try {
    $ready = $starter->start(15);
    check($ready['status'] === 'success' && $ready['readiness'] === 'verified', 'Startup requires a live agent and authenticated www-data web from the selected root');
    $statusPath = $config->persistentRoot() . '/runtime/agent-status.json';
    $status = json_decode(file_get_contents($statusPath), true);
    $wrong = $status;
    $wrong['start_id'] = str_repeat('0', 64);
    file_put_contents($statusPath, json_encode($wrong));
    check(!privateCall($starter, 'agentReady', [$ready['agent_pid']]), 'A heartbeat from another startup cannot pass readiness');
    $wrong = $status;
    $wrong['updated_at'] = microtime(true) - 120;
    file_put_contents($statusPath, json_encode($wrong));
    check(!privateCall($starter, 'agentReady', [$ready['agent_pid']]), 'A stale heartbeat cannot pass readiness');
    file_put_contents($statusPath, json_encode($status));
    $lock = new InstanceLock($config->persistentRoot() . '/runtime/startup.lock');
    $lock->release();
    check(true, 'Detached children do not inherit the startup lock');
    $hash = hash_file('sha256', $config->profilePath());
    foreach (['runtime:start', 'agent', 'agent:once'] as $command) {
        $result = $runner->run([PHP_BINARY, $cli, $command], 5);
        check($result['exit_code'] === 2 && strpos($result['stderr'], 'already active') !== false, 'Duplicate ' . $command . ' is rejected before consuming operations');
    }
    check(hash_file('sha256', $config->profilePath()) === $hash, 'Duplicate commands preserve the desired profile');
    $repository = new OperationRepository($config);
    $operation = (new OperationService($repository))->create('install_extension', 'not_in_catalog', 'isolated-startup-test');
    $deadline = microtime(true) + 8;
    do {
        $resultPath = $repository->resultPath($operation->id);
        $result = is_file($resultPath) ? json_decode(file_get_contents($resultPath), true) : null;
        if (is_array($result) && $result['status'] === 'skipped') break;
        usleep(100000);
    } while (microtime(true) < $deadline);
    check(is_array($result) && $result['status'] === 'skipped' && count($repository->pending()) === 0, 'The sole agent consumes an isolated harmless operation');
    check(substr_count(file_get_contents($config->agentLog()), 'processing operation id=' . $operation->id) === 1, 'The isolated operation is processed exactly once');
    privateCall($starter, 'stopOwnedChildren');
    $lease = new InstanceLock($repository->consumerLockPath());
    $lease->release();
    check(true, 'Agent lease is released by process termination');

    $streams = [];
    $processes = [];
    for ($i = 0; $i < 2; $i++) {
        $pipes = [];
        $processes[$i] = \Wsdd\PhpAdmin\Support\Process::open([PHP_BINARY, $cli, 'runtime:start'], [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes);
        fclose($pipes[0]);
        $streams[$i] = $pipes;
    }
    $codes = [];
    $winner = null;
    foreach ($processes as $index => $process) {
        $stdout = stream_get_contents($streams[$index][1]);
        $stderr = stream_get_contents($streams[$index][2]);
        fclose($streams[$index][1]);
        fclose($streams[$index][2]);
        $codes[] = proc_close($process);
        $result = json_decode($stdout, true);
        if (is_array($result) && isset($result['readiness']) && $result['readiness'] === 'verified') $winner = $result;
    }
    if ($winner !== null) {
        $owned = [];
        foreach ([$winner['agent_pid'], $winner['web_group_pid']] as $pid) $owned[] = ['pid' => $pid, 'identity' => privateCall($starter, 'identity', [$pid])];
        privateSet($starter, 'children', $owned);
    }
    sort($codes);
    check($codes === [0, 2] && $winner !== null, 'Two genuinely simultaneous CLI starts produce exactly one verified runtime');
    privateCall($starter, 'stopOwnedChildren');

    $lock = new InstanceLock($config->persistentRoot() . '/runtime/startup.lock');
    $blocked = $runner->run([PHP_BINARY, $cli, 'runtime:start'], 5);
    $lock->release();
    check($blocked['exit_code'] === 2, 'Concurrent startup cannot enter the startup critical section');

    $occupied = stream_socket_server('tcp://127.0.0.1:' . $config->serverPort(), $errno, $message);
    check(is_resource($occupied), 'The isolated web port is released during cleanup');
    $blocked = $runner->run([PHP_BINARY, $cli, 'runtime:start'], 5);
    check($blocked['exit_code'] === 2 && strpos($blocked['stderr'], 'port is unavailable') !== false && is_resource($occupied), 'Occupied port fails without killing its owner or mutating the profile');
    fclose($occupied);
    check(hash_file('sha256', $config->profilePath()) === $hash, 'Startup failures preserve profile contents');

    $failureStarter = new RuntimeStarter($config, $root);
    $startId = bin2hex(random_bytes(32));
    privateSet($failureStarter, 'startId', $startId);
    $agent = privateCall($failureStarter, 'launch', [[PHP_BINARY, '-r', 'sleep(20);'], $base . '/logs/timeout-agent.log']);
    $web = privateCall($failureStarter, 'launch', [[PHP_BINARY, '-S', '127.0.0.1:' . $config->serverPort(), '-t', $root . '/public'], $base . '/logs/timeout-web.log']);
    $repository->publishAgentStatus(['pid' => $agent['pid'], 'root' => realpath($root), 'start_id' => $startId, 'state' => 'ready', 'updated_at' => microtime(true)]);
    $context = stream_context_create(['http' => ['timeout' => 1, 'header' => 'X-WSDD-Runtime-Probe: ' . $startId . "\r\n", 'ignore_errors' => true]]);
    $deadline = microtime(true) + 2;
    do {
        $body = @file_get_contents('http://127.0.0.1:' . $config->serverPort() . '/runtime-health.php', false, $context);
        $foreign = $body === false ? null : json_decode($body, true);
        if (is_array($foreign)) break;
        usleep(10000);
    } while (microtime(true) < $deadline);
    check(isset($http_response_header[0], $foreign['user']) && strpos($http_response_header[0], '200') !== false && $foreign['user'] === 'root', 'Fixture really returns HTTP 200 but runs under the wrong identity');
    $timeout = false;
    try { privateCall($failureStarter, 'awaitReady', [$agent, $web, 0.3]); }
    catch (RuntimeException $error) { $timeout = strpos($error->getMessage(), 'timed out') !== false; }
    check($timeout, 'A 200 response with the wrong web identity cannot pass readiness and times out');
    check(!privateCall($failureStarter, 'owns', [$agent]) && !privateCall($failureStarter, 'owns', [$web]), 'Timeout cleans up only the child process groups created by this attempt');
    $agent = privateCall($failureStarter, 'launch', [[PHP_BINARY, '-r', 'sleep(20);'], $base . '/logs/exit-agent.log']);
    $web = privateCall($failureStarter, 'launch', [[PHP_BINARY, '-r', 'usleep(300000);exit(7);'], $base . '/logs/exit-web.log']);
    usleep(400000);
    $exited = false;
    try { privateCall($failureStarter, 'awaitReady', [$agent, $web, 1]); }
    catch (RuntimeException $error) { $exited = strpos($error->getMessage(), 'exited before') !== false; }
    check($exited && !privateCall($failureStarter, 'owns', [$agent]), 'A child that exits during startup fails readiness and cleans up its sibling');
    $lease = new InstanceLock($repository->consumerLockPath());
    $lease->release();
    check(hash_file('sha256', $realConfig->profilePath()) === $before, 'Real persistent profile remains untouched');
} finally {
    privateCall($starter, 'stopOwnedChildren');
    if ($failureStarter !== null) privateCall($failureStarter, 'stopOwnedChildren');
    foreach ($previous as $name => $value) putenv($value === false ? $name : $name . '=' . $value);
    removeFixture($base);
}
