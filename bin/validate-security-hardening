#!/usr/bin/env php
<?php 
require dirname(__DIR__) . '/src/Support/bootstrap.php';
use Wsdd\PhpAdmin\Agent\AgentLogger;
use Wsdd\PhpAdmin\Agent\AgentRunner;
use Wsdd\PhpAdmin\Agent\OperationProcessor;
use Wsdd\PhpAdmin\Audit\AuditLogger;
use Wsdd\PhpAdmin\Extensions\ExtensionCatalog;
use Wsdd\PhpAdmin\Extensions\ExtensionInstaller;
use Wsdd\PhpAdmin\Ini\ManagedIniRepository;
use Wsdd\PhpAdmin\Operations\OperationRepository;
use Wsdd\PhpAdmin\Operations\OperationService;
use Wsdd\PhpAdmin\Operations\OperationType;
use Wsdd\PhpAdmin\Profile\ProfileRepository;
use Wsdd\PhpAdmin\Profile\ProfileStateRecorder;
use Wsdd\PhpAdmin\Recovery\IniBackupRepository;
use Wsdd\PhpAdmin\Reconciliation\ManagedReconciler;
use Wsdd\PhpAdmin\Runtime\RuntimeDetector;
use Wsdd\PhpAdmin\Service\ServiceReloader;
use Wsdd\PhpAdmin\Support\AppConfig;
$root = sys_get_temp_dir() . DIRECTORY_SEPARATOR . 'wsdd-php-admin-hardening-' . bin2hex(random_bytes(4));
$profile = $root . DIRECTORY_SEPARATOR . 'profile';
$ini = $root . DIRECTORY_SEPARATOR . 'ini';
$logs = $root . DIRECTORY_SEPARATOR . 'logs';
foreach ([$profile, $ini, $logs] as $directory) {
    if (!mkdir($directory, 0775, true) && !is_dir($directory)) {
        throw new RuntimeException(sprintf('Unable to create "%s".', $directory));
    }
}
putenv('WSDD_PHP_ADMIN_PROFILE_DIR=' . $profile);
putenv('WSDD_PHP_ADMIN_INI_DIR=' . $ini);
putenv('WSDD_PHP_ADMIN_LOG_DIR=' . $logs);
putenv('WSDD_PHP_ADMIN_AGENT_LOG=' . $logs . DIRECTORY_SEPARATOR . 'agent.log');
putenv('WSDD_PHP_ADMIN_AUDIT_LOG=' . $logs . DIRECTORY_SEPARATOR . 'audit.log');
$config = AppConfig::loadDefault();
$repository = new OperationRepository($config);
$service = new OperationService($repository);
$profiles = new ProfileRepository($config);
$managedIni = new ManagedIniRepository($config);
$reloader = new ServiceReloader();
$extensionInstaller = new ExtensionInstaller(new ExtensionCatalog());
$managedReconciler = new ManagedReconciler($profiles, $managedIni, $reloader, $extensionInstaller);
$audit = new AuditLogger($config);
$runner = new AgentRunner($repository, new OperationProcessor($managedIni, $profiles, $reloader, new ProfileStateRecorder($profiles, new RuntimeDetector()), $managedReconciler, $extensionInstaller, new IniBackupRepository($config, $managedIni), $audit), new AgentLogger($config), $managedReconciler);
$iniPath = $ini . DIRECTORY_SEPARATOR . 'zz-wsdd-php-admin-curl.ini';
file_put_contents($iniPath, "extension=curl\n");
$disable = $service->create(OperationType::DISABLE_EXTENSION, 'curl', 'hardening-test');
$runner->runOnce();
assertTrue(!is_file($iniPath), 'disable_extension removes managed INI');
$rollback = $service->create(OperationType::ROLLBACK_EXTENSION, 'curl', 'hardening-test');
$runner->runOnce();
assertTrue(is_file($iniPath), 'rollback_extension restores managed INI');
assertTrue(trim((string) file_get_contents($iniPath)) === 'extension=curl', 'rollback restores original INI content');
$backupFiles = glob($config->backupDir() . DIRECTORY_SEPARATOR . 'ini' . DIRECTORY_SEPARATOR . '*.json') ?: [];
assertTrue(count($backupFiles) >= 1, 'managed operation creates rollback backup');
assertTrue(is_file($config->auditLog()), 'agent writes audit log');
$auditLog = (string) file_get_contents($config->auditLog());
assertTrue(str_contains($auditLog, OperationType::DISABLE_EXTENSION), 'audit log records disable operation');
assertTrue(str_contains($auditLog, OperationType::ROLLBACK_EXTENSION), 'audit log records rollback operation');
fwrite(STDOUT, "Security hardening validation passed.\n");
/**
 * @param bool $condition
 * @param string $message
 * @return void
 */
function assertTrue($condition, $message)
{
    $condition = \Wsdd\PhpAdmin\Support\TypeGuard::check($condition, 'bool');
    $message = \Wsdd\PhpAdmin\Support\TypeGuard::check($message, 'string');
    if (!$condition) {
        throw new RuntimeException('Validation failed: ' . $message);
    }
}
